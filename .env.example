# EasyLife works with NO configuration: without a key it runs in Local Demo Mode
# (rule-based planning engine, data stored in your browser's IndexedDB).
#
# To enable Real AI Mode, copy this file to .env.local and add a key:
#   macOS / Linux:  cp .env.example .env.local
#   Windows (cmd):  copy .env.example .env.local
# then restart `npm run dev`.
#
# The key is only ever read on the server (src/app/api/ai/route.ts).
# It is never sent to the browser. Do not prefix it with NEXT_PUBLIC_.

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model used for planning (default: claude-opus-5-5)
EASYLIFE_AI_MODEL=
